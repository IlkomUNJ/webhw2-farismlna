<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title || "Admin Panel" }}</title>
    @vite(['resources/css/admin.css', 'resources/js/app.js'])
  </head>

  <body class="flex min-h-screen bg-gray-100 text-gray-800">
    <!-- Sidebar -->
    @include('partials/sidebar')

    <!-- Main Content -->
    <div class="flex-1 flex flex-col">
      <!-- Header -->
      <header class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between">
        <h2 class="text-xl font-semibold text-gray-800">{{ title }}</h2>
        <form action="{{ route('admin.logout') }}" method="POST">
          <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-700 transition">
            Logout
          </button>
        </form>
      </header>

      <!-- Flash Messages -->
      @if(flashMessages.get('success') || flashMessages.get('error'))
        <div class="flex justify-center mt-4">
          <div class="w-full max-w-7xl px-8">
            @if(flashMessages.get('success'))
              <div class="bg-green-50 border border-green-400 text-green-800 px-4 py-3 rounded-md flex items-center justify-between shadow-sm">
                <div><strong class="font-semibold">Success:</strong> {{ flashMessages.get('success') }}</div>
                <button class="ml-4 text-green-700 hover:text-green-900" onclick="this.parentElement.parentElement.remove()">✕</button>
              </div>
            @endif

            @if(flashMessages.get('error'))
              <div class="bg-red-50 border border-red-400 text-red-800 px-4 py-3 rounded-md flex items-center justify-between shadow-sm">
                <div><strong class="font-semibold">Error:</strong> {{ flashMessages.get('error') }}</div>
                <button class="ml-4 text-red-700 hover:text-red-900" onclick="this.parentElement.parentElement.remove()">✕</button>
              </div>
            @endif
          </div>
        </div>
      @endif

      <!-- Page Content -->
      <main class="flex-1 p-8 overflow-y-auto">
        {{{ await $slots.main() }}}
      </main>
    </div>
  </body>
</html>
