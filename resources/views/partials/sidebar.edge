<aside class="w-64 bg-slate-800 text-white flex flex-col">
  <!-- Logo / Title -->
  <div class="px-6 py-5 border-b border-slate-700">
    <h2 class="text-lg font-bold tracking-wide">Admin Panel</h2>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-4 py-6 space-y-1">
    @each(routeItem in [
      { name: 'Dashboard', route: 'admin.dashboard'},
      { name: 'Services', route: 'admin.services.index'},
      { name: 'Portfolios', route: 'admin.portfolios.index'},
      { name: 'Wishlist', route: 'admin.wishlist.index' }
    ])
      <a href="{{ route(routeItem.route) }}"
         class="flex items-center gap-3 px-4 py-2 rounded-lg text-sm font-medium 
                transition-colors duration-150 
                {{ request.matchesRoute(routeItem.route) 
                  ? 'bg-slate-700 text-white' 
                  : 'text-slate-300 hover:bg-slate-700 hover:text-white' }}">
        {{ routeItem.name }}
      </a>
    @endeach
  </nav>

  <!-- Footer -->
  <div class="px-4 py-4 border-t border-slate-700">
    <p class="text-xs text-slate-400">&copy; 2025 Admin Panel</p>
  </div>
</aside>
