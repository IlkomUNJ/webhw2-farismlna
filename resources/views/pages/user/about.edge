@layout.app({title: "Designify - About"})

@slot('main')
    <main>
        <section class="page-header">
            <div class="container">
                <h1 class="page-title">About Designify</h1>
                <p class="page-description">Passionate designers creating exceptional brand experiences</p>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="about-content">
                    <div class="about-text">
                        <h2>Our Story</h2>
                        <p>Designify started in 2020 with a simple goal, to help small businesses get professional design work at affordable prices. We believe every business deserves great design, no matter how big or small.</p>
                        <p>Our team of talented designers has helped hundreds of businesses create beautiful logos, brand identities, and marketing materials. We work with clients from all over the world and love what we do.</p>
                    </div>
                    <div class="about-image">
                        <img src="resources/images/about.jpg" alt="Our team working">
                    </div>
                </div>
            </div>
        </section>
    </main>
@endslot

@end