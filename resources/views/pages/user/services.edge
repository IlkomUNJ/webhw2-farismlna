@layout.app({title: "Designify - Services"})

@slot('main')
<main>
    {{-- {{ JSON.stringify(services[0]) }} --}}
    <section class="page-header">
        <div class="container">
            <h1 class="page-title">Our Services</h1>
            <p class="page-description">Comprehensive design solutions to grow your business</p>
        </div>
    </section>
    <section class="section" style="padding: 30px;">
        <div class="container">
            <div class="search-bar" ud  style="margin-bottom: 30px; text-align: center;">
                <form method="GET" action="{{ route('services') }}" class="search-form">
                    <input type="text" name="search" value="{{ search || '' }}" id="service-search" placeholder="Search services..." style="padding: 10px 15px; width: 60%; max-width: 400px; border: 1px solid #ccc; border-radius: 6px;">
                    <button id="search-btn" type="submit" class="btn btn-primary" style="padding: 10px 20px;">Search</button>
                </form>
            </div>
            <div class="services-grid">
                @each(item in services)
                    <div class="service-card" data-id="{{ item.id }}" data-name="{{ item.name }}">
                    <img src="{{ item.imageUrl }}" alt="{{ item.name }}">
                    <h3 class="service-title">{{ item.name }}</h3>
                    <p class="service-description">{{ item.description }}</p>
                    <div class="service-price">Starting at ${{ item.price }}</div>
                    <div class="service-actions">
                        <button href="{{ route('contact') }}" class="btn btn-primary">Order Now</button>
                        <button 
                            class="btn btn-secondary btn-wishlist"
                            data-id="{{ item.id }}"
                            data-name="{{ item.name }}"
                            data-description="{{ item.description }}"
                            data-price="{{ item.price }}"
                            data-image="{{ item.imageUrl }}"
                            onclick="toggleWishlist({{ item.id }})"
                            class="text-red-600 hover:text-red-800"
                            >
                            Wishlist
                        </button>
                    </div>
                    </div>
                @end
            </div>
        </div>
    </section>
