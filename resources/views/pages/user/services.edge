    <section class="process-section">
        <div class="container">
            <header class="section-header">
                <h2 class="section-title">Our Design Process</h2>
                <p class="section-description" style="margin-bottom: 20px;">A proven approach that delivers exceptional results</p>
            </header>
            <div class="process-steps">
                <div class="process-step">
                    <div class="step-number">1</div>
                    <h3 class="step-title">Discovery</h3>
                    <p class="step-description">We learn about your business, goals, and target audience to inform our design strategy.</p>
                </div>
                <div class="process-step">
                    <div class="step-number">2</div>
                    <h3 class="step-title">Concept</h3>
                    <p class="step-description">Our designers create initial concepts based on your brand requirements and preferences.</p>
                </div>
                <div class="process-step">
                    <div class="step-number">3</div>
                    <h3 class="step-title">Refinement</h3>
                    <p class="step-description">We refine the chosen concept through collaboration and feedback until it's perfect.</p>
                </div>
                <div class="process-step">
                    <div class="step-number">4</div>
                    <h3 class="step-title">Delivery</h3>
                    <p class="step-description">Final files are delivered in all necessary formats along with usage guidelines.</p>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
     window.servicesData = {{ services | safe }}

    let guestId = localStorage.getItem('guest_id')
    if (!guestId) {
    guestId = crypto.randomUUID()
    localStorage.setItem('guest_id', guestId)
    }

    async function toggleWishlist(serviceId) {
    const res = await fetch('/wishlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ guest_id: guestId, service_id: serviceId })
    })
    const result = await res.json()
    console.log(result)
    alert(result.status === 'added' ? 'Added to wishlist!' : 'Removed from wishlist!')
    }
</script>
