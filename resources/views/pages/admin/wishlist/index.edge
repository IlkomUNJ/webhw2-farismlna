@layout.admin({ title: 'Wishlist Overview' })

@slot('main')
<main class="min-h-screen bg-gray-100 py-10 px-4">
  <div class="max-w-5xl mx-auto bg-white shadow-sm rounded-xl p-8 border border-gray-200">
    <h1 class="text-2xl font-semibold text-gray-800 mb-6">Wishlist Overview</h1>

    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Guest ID</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Service</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Category</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Price</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        @each(wishlist in wishlists)
        <tr>
          <td class="px-6 py-3 text-sm text-gray-700">{{ wishlist.guestId }}</td>
          <td class="px-6 py-3 text-sm text-gray-800">{{ wishlist.service.name }}</td>
          <td class="px-6 py-3 text-sm text-gray-600">{{ wishlist.service.category }}</td>
          <td class="px-6 py-3 text-sm text-gray-700">${{ wishlist.service.price }}</td>
        </tr>
        @endeach

        @if(wishlists.length === 0)
        <tr>
          <td colspan="4" class="text-center py-6 text-gray-500">No wishlist data found.</td>
        </tr>
        @endif
      </tbody>
    </table>
  </div>
</main>
@endslot
@end
